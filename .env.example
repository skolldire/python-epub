# Copy this file to .env and fill in the values before running docker-compose.
# Values shown are the defaults used when a variable is not set.

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" to enable production mode.
# When ENVIRONMENT=production, API_KEY is required.
ENVIRONMENT=development

# ── Authentication ────────────────────────────────────────────────────────────
# Required when ENVIRONMENT=production. Leave empty to disable auth.
# Generate with: openssl rand -hex 32
API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Restrict to your domain in production. Leave empty to allow all origins.
# Example: CORS_ORIGINS=["https://yourapp.example.com"]
CORS_ORIGINS=

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=52428800
MAX_PAGES=1000
MAX_CONVERSION_SECONDS=300
CONVERSION_WORKERS=1

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
METRICS_ENABLED=true

# ── Port ──────────────────────────────────────────────────────────────────────
PORT=8000
