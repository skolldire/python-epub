APP_NAME=pdf-epub
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

UPLOAD_DIR=/tmp/pdf_epub/uploads
EPUB_DIR=/tmp/pdf_epub/epubs
MAX_UPLOAD_BYTES=52428800

OCR_LANG=spa+eng
# Development: allow all origins.
# Production: restrict to your domain, e.g. CORS_ORIGINS=["https://yoursite.com"]
CORS_ORIGINS=["*"]
