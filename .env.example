APP_NAME=pdf-epub
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

UPLOAD_DIR=/tmp/pdf_epub/uploads
EPUB_DIR=/tmp/pdf_epub/epubs
MAX_UPLOAD_BYTES=52428800

OCR_LANG=spa+eng

# Authentication — leave unset to disable (development / local use).
# In production, generate with: openssl rand -hex 32
# API_KEY=your-secret-key-here

# CORS — restrict to your domain in production.
# Development: allow all origins.
# Production: CORS_ORIGINS=["https://yourapp.example.com"]
CORS_ORIGINS=["*"]

# Conversion safety limits
MAX_PAGES=1000
MAX_CONVERSION_SECONDS=300
